{
  "name": "canibal-2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx server/main.ts\" \"vite\"",
    "start": "tsx server/main.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "stress": "tsx server/stress.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.6"
  }
}
